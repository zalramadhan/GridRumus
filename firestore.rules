rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPracticeProgress(data, userId) {
      return data.keys().hasAll(['userId', 'solvedQuestionIds', 'formulaBestScores', 'challengeHistory', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'solvedQuestionIds', 'formulaBestScores', 'challengeHistory', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.solvedQuestionIds is list
        && data.solvedQuestionIds.size() <= 200
        && (data.solvedQuestionIds.size() == 0 || data.solvedQuestionIds[0] is string)
        && data.formulaBestScores is map
        && data.formulaBestScores.keys().size() <= 50
        && data.challengeHistory is list
        && data.challengeHistory.size() <= 10
        && (data.challengeHistory.size() == 0 || data.challengeHistory[0] is map)
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);

      allow delete: if false;

      match /progress/{progressId} {
        allow get: if isValidId(userId) && isValidId(progressId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(progressId)
          && progressId == 'practice'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidPracticeProgress(incoming(), userId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(progressId)
          && progressId == 'practice'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidPracticeProgress(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['solvedQuestionIds', 'formulaBestScores', 'challengeHistory', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isValidId(userId)
          && isValidId(progressId)
          && isVerifiedUser()
          && isOwner(userId);
      }
    }
  }
}
