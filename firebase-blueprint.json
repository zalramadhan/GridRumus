{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated GridRumus user profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google account.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "PracticeProgress": {
      "title": "PracticeProgress",
      "description": "Synchronized Excel practice progress and challenge history for an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "solvedQuestionIds": {
          "type": "array",
          "description": "List of solved practice question IDs."
        },
        "formulaBestScores": {
          "type": "object",
          "description": "Best score map keyed by formula ID."
        },
        "challengeHistory": {
          "type": "array",
          "description": "Recent random challenge session results (max 10)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last progress sync."
        }
      },
      "required": ["userId", "solvedQuestionIds", "formulaBestScores", "challengeHistory", "updatedAt"]
    },
    "PromoBannerConfig": {
      "title": "PromoBannerConfig",
      "description": "Shopee Affiliate arrival promo popup configuration managed by verified admins.",
      "type": "object",
      "properties": {
        "isActive": {
          "type": "boolean",
          "description": "Whether the arrival promo popup is shown on page load."
        },
        "highlightText": {
          "type": "string",
          "description": "Short kicker text above the promo headline.",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "description": "Main promo headline shown inside the popup.",
          "minLength": 1,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "description": "Supporting promotional description text.",
          "minLength": 1,
          "maxLength": 200
        },
        "ctaLabel": {
          "type": "string",
          "description": "Primary call-to-action button label.",
          "minLength": 1,
          "maxLength": 40
        },
        "affiliateUrl": {
          "type": "string",
          "description": "Shopee Affiliate destination URL (must start with https://).",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https://.+"
        },
        "bannerImageUrl": {
          "type": "string",
          "description": "Optional custom HTTPS banner image URL or blank to use built-in generated banner.",
          "maxLength": 500
        },
        "updatedByUid": {
          "type": "string",
          "description": "UID of the verified admin who last updated the promo.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last promo update."
        }
      },
      "required": [
        "isActive",
        "highlightText",
        "title",
        "subtitle",
        "ctaLabel",
        "affiliateUrl",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Optional delegated admin marker document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Admin Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was provisioned."
        }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile documents owned by {userId}."
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": {
        "$ref": "#/entities/PracticeProgress"
      },
      "description": "User practice progress documents owned by {userId}."
    },
    "/promotions/{promoId}": {
      "schema": {
        "$ref": "#/entities/PromoBannerConfig"
      },
      "description": "Publicly readable promo banner config (`shopee_popup`) editable only by verified admins."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Server-provisioned admin records."
    }
  }
}
