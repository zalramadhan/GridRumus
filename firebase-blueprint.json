{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated GridRumus user profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google account.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "PracticeProgress": {
      "title": "PracticeProgress",
      "description": "Synchronized Excel practice progress and challenge history for an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "solvedQuestionIds": {
          "type": "array",
          "description": "List of solved practice question IDs."
        },
        "formulaBestScores": {
          "type": "object",
          "description": "Best score map keyed by formula ID."
        },
        "challengeHistory": {
          "type": "array",
          "description": "Recent random challenge session results (max 10)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last progress sync."
        }
      },
      "required": ["userId", "solvedQuestionIds", "formulaBestScores", "challengeHistory", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile documents owned by {userId}."
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": {
        "$ref": "#/entities/PracticeProgress"
      },
      "description": "User practice progress documents owned by {userId}."
    }
  }
}
